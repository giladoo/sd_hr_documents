<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.module.category" id="module_category_sd_hr_documents">
        <field name="name">sd_hr_documents</field>
        <field name="description">requests.</field>
    </record>

    <record id="group_sd_hr_documents_users" model="res.groups">
        <field name="name">Users</field>
        <field name="category_id" ref="module_category_sd_hr_documents"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sd_hr_documents_admins" model="res.groups">
        <field name="name">Administrators</field>
        <field name="category_id" ref="module_category_sd_hr_documents"/>
        <field name="implied_ids" eval="[(4, ref('group_sd_hr_documents_users'))]"/>
    </record>


    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('sd_hr_documents.group_sd_hr_documents_admins'))]"/>
    </record>


</odoo>
